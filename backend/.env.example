# Postgres connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/currency_tracker

# Access key for exchangerate.host. Sent as a query parameter, so leave the
# base URL on https unless you are pointing at a local mock server.
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_BASE=https://api.exchangerate.host
EXCHANGE_RATE_TIMEOUT_SECONDS=10

# Comma separated. Must match the origin the frontend is served from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minute of each hour at which rates are pulled.
FETCH_SCHEDULE_MINUTE=0

LOG_LEVEL=INFO
