# Optional. Defaults to backend/currency_tracker.db, so leaving this unset
# is fine for local use. Point it elsewhere to keep the file outside the repo.
# DATABASE_URL=sqlite:///./currency_tracker.db

# Access key for exchangerate.host. Sent as a query parameter, so leave the
# base URL on https unless you are pointing at a local mock server.
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_BASE=https://api.exchangerate.host
EXCHANGE_RATE_TIMEOUT_SECONDS=10

# Comma separated. Must match the origin the frontend is served from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minute of each hour at which rates are pulled. Set SCHEDULER_ENABLED=false
# to boot the API without the background job.
FETCH_SCHEDULE_MINUTE=0
SCHEDULER_ENABLED=true

HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO
